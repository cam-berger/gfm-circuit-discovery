digraph full_circuit {
  rankdir=LR;
  bgcolor="white";
  graph [fontname="Helvetica", fontsize=11, labelloc="b", labeljust="l", nodesep=0.28, ranksep=0.85, fontcolor="#5A6672"];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="white", color="#5A6672", fontcolor="#16232E", penwidth=1.4, margin="0.12,0.08"];
  edge  [fontname="Helvetica", fontsize=9.5, color="#5A6672", fontcolor="#5A6672", arrowsize=0.8];
  label=<<b>The donor&#8211;acceptor mechanism, front to back</b>   <font color="#5A6672">a structured top-ranked causal core: address &#215; acceptor-local payload &#8594; L3H1 write &#8594; distributed readout</font><br align="left"/><font color="#5A6672">Payload-branch heads, N values, CIs, the H12&#8211;H10 interaction and the MLP0 mediation are read from a10_generator_edges.json (C31); n = 220 pairs / 196 genes; generator ceiling 0.282.</font><br align="left"/><font color="#5A6672">MLP0 mediates the layer-0 contribution: heads alone R = 0.136, heads + MLP0 R = 0.356. {L3H1, L2H15} removes 81.6% of coupling at 99.2% MLM health (C3).</font><br align="left"/><font color="#5A6672"><b>N are conditional causal necessities on held-out splits &#8212; they do NOT sum and are not additive fractions; the chain is strictly serial.</b></font><br align="left"/><font color="#5A6672">This is a structured top-ranked core inside an irreducibly distributed computation, NOT the smallest sufficient circuit: F(C)&#8776;0.005 when the complement is scrubbed and the held-out size curve has no knee &#8212; no minimality or completeness claim is made.</font><br align="left"/>>;
  seq   [label="acceptor-local\nsequence state", shape=box, style="dashed,rounded", color="#8794A0", fontcolor="#5A6672", penwidth=1.2];
  p3    [label="period-3 positional coordinate\nacross the donor&#8211;acceptor span   (C8)", shape=box, style="dashed,rounded", color="#0B6FB8", fontcolor="#0B6FB8", penwidth=1.4];
  subgraph cluster_addr {
    label=<<b>Address</b>  <font point-size="9" color="#5A6672">position geometry &#8594; L3H1 attention</font>>;
    labeljust="l"; color="#0B6FB8"; style="rounded"; bgcolor="#F4F8FC"; penwidth=1.2; fontcolor="#0B6FB8";
    L2H15 [label="L2H15 / MLP2\namplify + route address", color="#0B6FB8", penwidth=1.6];
  }
  subgraph cluster_payload {
    label=<<b>Payload generation</b>  <font point-size="9" color="#5A6672">A10 / C31, held-out, Directed-circuit level</font>>;
    labeljust="l"; color="#6A4A9C"; style="rounded"; bgcolor="#F7F9FB"; penwidth=1.2; fontcolor="#6A4A9C";
    subgraph cluster_l0 {
      label=<<font point-size="9" color="#5A6672">layer-0 load-bearing heads</font>>; labeljust="l"; color="#E1E7EC"; style="rounded"; bgcolor="#FBFCFD"; penwidth=1.0;
      L0H7 [label="L0H7\nN = +0.348 [0.300, 0.399]", color="#6A4A9C", penwidth=1.7];
      L0H12 [label="L0H12\nN = +0.160 [0.129, 0.192]", color="#6A4A9C", penwidth=1.7];
      L0H10 [label="L0H10\nN = +0.116 [0.090, 0.142]", color="#6A4A9C", penwidth=1.7];
      L0H8 [label="L0H8\nN = +0.016 [0.012, 0.020]", color="#8794A0", fontcolor="#5A6672", penwidth=1.1];
      L0H13 [label="L0H13\nN = +0.001 [0.001, 0.002]", color="#8794A0", fontcolor="#5A6672", penwidth=1.1];
      L0H11 [label="L0H11\nN = +0.001 [0.001, 0.001]", color="#8794A0", fontcolor="#5A6672", penwidth=1.1];
    }
    MLP0 [label="MLP0\nN = +0.354 [0.292, 0.417]", color="#6A4A9C", penwidth=1.7];
    MLP1 [label="MLP1\nN = +0.434 [0.365, 0.507]", color="#6A4A9C", penwidth=1.6];
    MLP2 [label="MLP2\nN = +0.880 [0.809, 0.953]", color="#6A4A9C", penwidth=1.6];
  }
  L3H1 [label=<<b>L3H1</b><br/>bind address &#215; payload, write donor-side<br/><font point-size="9" color="#5A6672">restore recovers 0.83 of coupling (C17)</font>>, color="#6A4A9C", penwidth=2.4, fillcolor="#F3EFF8"];
  Uinfo [label=<low-rank <b>U_info</b> donor-side object<br/><font point-size="9" color="#5A6672">rank-8 recovers ≈0.92 vs random &#8804;0.05 (C16)</font>>, shape=box, style="rounded,filled", color="#6A4A9C", fillcolor="white", penwidth=1.5];
  deliver [label="L4H0 / L4H2 / L5H11\ndonor-side transport", color="#5A6672", penwidth=1.4];
  readout [label=<<b>masked-donor MLM margin</b><br/><font point-size="9" color="#5A6672">paired-acceptor corruption: +0.872 [0.771, 0.969] (C1)</font>>, shape=box, style="rounded,filled", color="#6A4A9C", fillcolor="#F3EFF8", penwidth=2.0];
  p3 -> L2H15 [color="#0B6FB8", penwidth=2.0, xlabel="carrier routing"];
  L2H15 -> L3H1 [color="#0B6FB8", penwidth=2.0, label="attention\naddress"];
  p3 -> L3H1 [color="#0B6FB8", style=dashed, penwidth=1.1, constraint=false, xlabel="deletion 0.946→0.027 (C8)"];
  seq -> L0H7 [color="#8794A0", penwidth=1.0];
  L0H7 -> MLP0 [color="#6A4A9C", penwidth=4.00];
  seq -> L0H12 [color="#8794A0", penwidth=1.0];
  L0H12 -> MLP0 [color="#6A4A9C", penwidth=2.38];
  seq -> L0H10 [color="#8794A0", penwidth=1.0];
  L0H10 -> MLP0 [color="#6A4A9C", penwidth=2.00];
  seq -> L0H8 [color="#E3E9EE", penwidth=0.8];
  L0H8 -> MLP0 [color="#8794A0", penwidth=1.14];
  seq -> L0H13 [color="#E3E9EE", penwidth=0.8];
  L0H13 -> MLP0 [color="#8794A0", penwidth=1.01];
  seq -> L0H11 [color="#E3E9EE", penwidth=0.8];
  L0H11 -> MLP0 [color="#8794A0", penwidth=1.01];
  L0H12 -> L0H10 [dir=none, style=dashed, color="#8794A0", constraint=false, xlabel="interaction -0.126 (D)\npartially redundant"];
  MLP0 -> MLP1 [color="#6A4A9C", penwidth=2.2];
  MLP1 -> MLP2 [color="#6A4A9C", penwidth=2.2];
  MLP2 -> L3H1 [color="#6A4A9C", penwidth=2.4, label="acceptor-local\npayload"];
  L3H1 -> Uinfo [color="#6A4A9C", penwidth=2.0, minlen=2, label="donor-side\nwrite"];
  Uinfo -> deliver [color="#6A4A9C", penwidth=1.6, minlen=2, label="0.93 of L3H1 effect\nroutes here (C17)"];
  deliver -> readout [color="#6A4A9C", penwidth=1.8, minlen=2];
}
