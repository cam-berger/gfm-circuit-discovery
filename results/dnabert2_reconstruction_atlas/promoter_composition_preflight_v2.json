  "checks_architecture_forced": {
    "M1_identity": {
      "class": "empirically_falsifiable",
      "why": "Exercises the same in-place token-substitution function the endpoints use, with a boundary-case empty index list. Catches a bug where an empty index list is mishandled (e.g. a fallback that masks everything, or an index error). Scope is narrower than a general regression guard on the masking path: the masking loop body never executes when there is nothing to mask, so this specific check cannot exercise the aliasing/off-by-one bug classes only a non-empty index list would reveal."
    },
    "M2_caliper_respected": {
      "class": "architecture_forced",
      "why": "select_matched_pair/select_unmatched_pair only ever return a candidate that already clears the caliper/separation filter internally -- PASS is a regression guard on this script's own wiring (did it pass the config's actual caliper values), not independent evidence about the selected pairs."
    },
    "M3_equal_dose": {
      "class": "architecture_forced",
      "why": "paired_fixed_dose_tile only ever returns a tile at exactly token_dose adjacent genomic tokens within maximum_cover_length_difference_nt, or returns None -- no cover this script could score can violate M3."
    },
    "M4_region_containment": {
      "class": "architecture_forced",
      "why": "enumerate_region_covers only ever yields a cover whose centre already sits inside [region_start, region_end] -- no cover this script could score can violate M4."
    },
    "batch_invariance": {
      "class": "empirically_falsifiable",
      "why": "Would fail on any real batch-dependent numerical drift."
    },
    "permuted_label_fpr": {
      "class": "empirically_falsifiable",
      "why": "Re-derives, per locus, a genuinely distinct role-swapped selection+scoring outcome (see _check_permuted_label_fpr's docstring) rather than sign-flipping an already-fixed number -- enumerate_region_covers' centre/containment filter is evaluated against whichever sequence plays 'target' for a given state, so the swapped-role cover set is not simply the negation of the true one and can genuinely differ from it."
    },
    "planted_positive": {
      "class": "empirically_falsifiable",
      "why": "The load-bearing sensitivity check: whether the unmatched arm's polarity genuinely exceeds the matched arm's by the P2 SESOI, from real forward passes over real (if non-biological) GUE sequences. A sibling instrument (IF30) failed an analogous calibration and was retired rather than trusted."
    },
    "projected_MDE": {
      "class": "empirically_falsifiable",
      "why": "A real arithmetic gate against the already-audited, outcome-blind matched-pair count; failed for the superseded v1 config (MDE 0.323 against a 0.28 ceiling at development n=122) before Amendment 1 raised the raw-pair target."
    }
  },
