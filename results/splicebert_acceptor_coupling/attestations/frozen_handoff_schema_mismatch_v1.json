    {
      "id": "acceptor-coupling/instrument/frozen-handoff-schema-mismatch",
      "title": "The frozen R1c package is incompatible with its frozen R5 consumer",
      "summary": "R1c v4's authentic validation preflight reports PREFLIGHT_GO with all 13 gates passing on 400 rows and 321 genes, but each serialized row carries six margin levels while the exact frozen R5 consumer requires exactly three P_* levels. The canonical chain therefore closes as INSTRUMENT_UNRESOLVED before target scoring.",
      "record_kind": "instrument",
      "status": "instrument-unresolved",
      "evidence_rung": "instrument",
      "review_tier": "confirmatory",
      "claim_eligible": false,
      "scope": "A prospectively frozen package-to-consumer compatibility check on the chr11/16/19 validation preflight; the R1c chr8/chr9 masked-acceptor target and all R5 scientific stages remained unscored.",
      "first_missing_bridge": "The frozen producer and consumer schemas do not compose, and the one-run no-post-outcome-redesign rule forbids repairing either side after the validation package was observed.",
