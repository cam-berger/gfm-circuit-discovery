      "status": "bounded",
      "evidence_rung": "behavior",
      "review_tier": "verification",
      "claim_eligible": true,
      "scope": "Checkpoint-specific matched GC-AG versus GT-AG behavior on validation chromosomes chr11, chr16, and chr19, held out from the donor-class development arc.",
