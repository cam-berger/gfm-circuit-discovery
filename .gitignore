__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store

# Runtime agent/session scratch. Scientific evidence belongs under results/ with a manifest.
/logs/
/handoff/
/scratch/

# External genomes, annotations, model archives, and derived data.
data/raw/
data/processed/
data/external/
data/models/

# Regenerable local caches.
data/cache/

# Model weights, fitted dictionaries, and raw activation captures.
#
# These are training/runtime outputs, not evidence: no claim row in any ledger
# is controlled by one. ~847 MB of them in the checkout (268 MiB packed) had
# been force-added past these rules and were untracked on 2026-07-31. The
# compact result JSON, its .manifest.json, and its audit are what make a claim
# checkable — commit those instead. If you ever need `git add -f` here, you are
# committing the wrong artifact.
#
# Note the exact scope: a manifest may still declare one of these as a
# hash-pinned INPUT, so a second-stage runner can need one regenerated before
# it will run. That is a reproduction step, not a missing claim artifact — see
# REPRODUCE.md §2.2 item 4.
checkpoints/
*.pt
*.safetensors
*.npz
*.npy
colab_results/**/*.pt
colab_results/**/*.jsonl
*.pkl
splicebert_code.zip
studies/**/colab_atlas_package/dist/

# Head–Context Atlas bulk intermediates are reproducible locally or preserved in
# the audited external run bundles. Keep compact results, manifests, and audits.
results/splicebert_head_context_atlas/**/target_shards/
results/splicebert_head_context_atlas/**/health_shards/
# R44 clean-alt screens: 25MB of shards each; the compact artifact of record is
# head_screen_clean_alt_comparison_v1.json (see R44).
results/splicebert_head_context_atlas/head_screen_clean_alt/
results/splicebert_head_context_atlas/development/head_screen_cc_baseline/
results/splicebert_head_context_atlas/atlas_context_packets_v1.jsonl
results/splicebert_head_context_atlas/atlas_context_packets_enriched_v1.jsonl
results/splicebert_head_context_atlas/atlas_context_sequences_v1.jsonl
results/splicebert_head_context_atlas/atlas_context_matched_v*.discovery.*.jsonl
results/splicebert_head_context_atlas/atlas_context_matched_v*.validation.*.jsonl
# Frozen Stage 2 runtime inputs: the overlay builder and its clean-checkout tests
# require this exact audited cohort. Earlier/superseded cohorts remain ignored.
!results/splicebert_head_context_atlas/atlas_context_matched_v7.validation.pairs.jsonl
!results/splicebert_head_context_atlas/atlas_context_matched_v7.validation.packets.jsonl
!results/splicebert_head_context_atlas/atlas_context_matched_v7.validation.sequences.jsonl
# The frozen Stage 2 overlay also carries its 256 outcome-blind health shards.
!results/splicebert_head_context_atlas/atlas_stage2_mechanism_v1/health_shards/
!results/splicebert_head_context_atlas/atlas_stage2_mechanism_v1/health_shards/packet_*.json
results/splicebert_head_context_atlas/atlas_discovery_v1.*_matrix.jsonl.gz
results/splicebert_head_context_atlas/atlas_discovery_v1.pairs.jsonl.gz

# PBC's full model-free source census is a regenerable multi-gigabyte construction
# intermediate. Its compact producer manifest and independent audit are tracked.
results/splicebert_positional_boundary_coherence/development/candidate_census_v1.json

# Runtime model/readout artifacts. Settled metrics and manifests belong under results/.
artifacts/
results/splicebert_partner_selection/**/*.jsonl

# Ad hoc rendered result figures. Publication figures under figures/ are tracked with provenance.
results/**/figures/
results/splicebert_coupling/ic2_feasibility_smoke.json
results/splicebert_coupling/ic2_calibration_smoke.json
.venv/

# R4 Colab distribution archives are reproducible from build_bundle.py; the compact
# artifacts of record are the reference panel and the result JSON plus their manifests.
studies/splicebert_acceptor_coupling/colab_r4_package/dist/

# Register-operator calibration retains every synthetic realization locally.
# Its compact result, manifest, and independent audit bind the full stream hash.
results/splicebert_register_operator_replication/*.records.jsonl.gz

studies/splicebert_register_operator_replication/planning/*.records.jsonl.gz

# CC model requests and construction payloads remain local, hash-bound runtime data.
results/splicebert_register_operator_replication/cells_v2.json.gz
results/splicebert_register_operator_replication/native_v2.json.gz
results/splicebert_register_operator_replication/historical_fidelity_v2.json.gz
studies/splicebert_register_operator_replication/planning/execution_construction_v*.json.gz
